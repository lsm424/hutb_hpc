  W7{"条件2:<br/>timestamp-bucket_start ＞ min_window_sec<br/>且 bucket_max-bucket_min<br/>＞ fluctuation_threshold ？"}
  W8["闭合当前桶<br/>输出8字段至降采样结果<br/>bucket_end = timestamp<br/>last_val = value<br/>重置状态机（新开口桶）"]
